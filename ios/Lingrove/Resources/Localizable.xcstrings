          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A forceful command. Use 食べてください for polite everyday requests."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "強い命令です。日常の丁寧な依頼には食べてくださいを使います。"
          }
        }
      }
    },
