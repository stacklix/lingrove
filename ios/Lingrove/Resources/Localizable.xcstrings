          }
        }
      }
    },
    "一段去る＋た；する→した，来る→きた。五段的て／で对应换成た／だ。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一段去る＋た；する→した，来る→きた。五段的て／で对应换成た／だ。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ichidan without る + た; する→した, 来る→きた. For godan, replace て/で with た/だ."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一段はるを取ってた。する→した、来る→きた。五段はて／でをた／だに替えます。"
          }
        }
      }
    },
    "五段的て形・た形": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "五段的て形・た形"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Godan te and ta forms"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "五段のテ形・タ形"
          }
        }
      }
    },
    "促音便：词尾变成っ，再接て或た。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "促音便：词尾变成っ，再接て或た。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemination: ending → っ, then て or た."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "促音便：語尾をっにして、て・たを付けます。"
          }
        }
      }
    },
    "拨音便：词尾变成ん，后接で或だ。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拨音便：词尾变成ん，后接で或だ。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasal change: ending → ん, then で or だ."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "撥音便：語尾をんにして、で・だを付けます。"
          }
        }
      }
    },
    "イ音便：く变い，后接て或た。": {
      "localizations": {
