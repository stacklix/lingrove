          "stringUnit": {
            "state": "translated",
            "value": "右上から交点を通って左下へ斜めに伸ばします。"
          }
        }
      }
    },
    "先写中间长竖。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先写中间长竖。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First draw the long central vertical."
