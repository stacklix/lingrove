          "stringUnit": {
            "state": "translated",
            "value": "イ形容詞 · 学校文法の形容詞"
          }
        }
      }
    },
    "以高い为例：去掉末尾い，保留高，再接下面的活用词尾。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以高い为例：去掉末尾い，保留高，再接下面的活用词尾。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For 高い, remove final い and add the endings below to 高."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高いなら、末尾のいを取って高に以下の活用語尾を付けます。"
          }
        }
      }
    },
    "去い＋かろ；后接う，表示推量。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "去い＋かろ；后接う，表示推量。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove い + かろ, then う for conjecture."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いを取ってかろ。うを付けて推量を表します。"
          }
        }
      }
    },
    "去い＋く／かっ。": {
      "localizations": {
