            "state" : "translated",
            "value" : "Irrealis + ない → negative: 読ま＋ない → 読まない."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未然形＋ない → ナイ形：読ま＋ない → 読まない。"
