            "state": "translated",
            "value": "可能形"
          }
        }
      }
    },
    "从右上向左绕过左侧与底部，回到起点闭合椭圆。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从右上向左绕过左侧与底部，回到起点闭合椭圆。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From upper right, curve left around the left and bottom, returning to close the oval."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上から左側と下側を回り、始点に戻って楕円を閉じます。"
          }
        }
      }
    },
    "从右上沿椭圆右侧下行，在基线处向右弯出。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从右上沿椭圆右侧下行，在基线处向右弯出。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Descend along the oval's right side and curve right at the baseline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上から楕円の右側を下り、基線で右へ曲げます。"
          }
        }
      }
    },
    "从下部向上绕出长环，在中腰向右绕出下部圆腹，回到左侧收笔。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从下部向上绕出长环，在中腰向右绕出下部圆腹，回到左侧收笔。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loop upward from below, curve right at mid-height into the lower bowl, and finish left."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下から上へ長い輪を描き、中ほどから右へ下の丸みを作って左で終えます。"
          }
        }
      }
    },
    "从左上弯向右下，越过基线绕出窄环，再向右上收笔。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从左上弯向右下，越过基线绕出窄环，再向右上收笔。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Curve from upper left to lower right, loop below the baseline, then finish up-right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左上から右下へ曲げ、基線の下で細い輪を作り、右上で終えます。"
          }
        }
      }
    },
    "从顶部右侧向左弯入，再向右下绕过字身右侧和底部，沿左侧回到字身上沿闭合。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从顶部右侧向左弯入，再向右下绕过字身右侧和底部，沿左侧回到字身上沿闭合。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Curve left from top right, around the right and bottom, then up the left to close."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上から左へ入り、右側と下側を回り、左側を上がって閉じます。"
          }
        }
      }
    },
    "从右上向左绕出上半弧，回到中部，再向左下绕出下半弧，在右下收笔。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从右上向左绕出上半弧，回到中部，再向左下绕出下半弧，在右下收笔。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Curve left through the upper arc, return to center, then make a lower arc and finish lower right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上から左へ上の弧を作り、中央に戻り、左下へ下の弧を描いて右下で終えます。"
          }
        }
      }
    },
    "从左向右写顶横，转向左下，再向右绕出下部弧线，末端向左弯成下伸钩。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从左向右写顶横，转向左下，再向右绕出下部弧线，末端向左弯成下伸钩。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw the top bar rightward, turn down-left, curve right below, then hook down-left."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上の横線を右へ、左下へ折れ、下で右へ回り、末尾を左下へ鉤状にします。"
          }
        }
      }
    },
    "从字身上沿向下写左竖。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从字身上沿向下写左竖。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw the left vertical down from the body top."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "字の上端から左の縦線を下へ書きます。"
          }
        }
      }
    },
    "从左竖中部向右上拱起，再沿右侧向下越过基线。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从左竖中部向右上拱起，再沿右侧向下越过基线。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arch up-right from the left vertical's midpoint, then descend past the baseline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左縦線の中ほどから右上へ山を作り、右側を基線の下まで下ろします。"
          }
        }
      }
    },
    "从顶部向左下绕出狭长椭圆，经底部与右侧回到起点。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从顶部向左下绕出狭长椭圆，经底部与右侧回到起点。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Curve down-left into a narrow oval, returning along the bottom and right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上から左下へ細長い楕円を描き、下と右を通って始点に戻ります。"
          }
        }
      }
    },
    "抬笔，从左向右写中横。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抬笔，从左向右写中横。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lift, then draw the middle bar left to right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペンを上げ、中央の横線を左から右へ書きます。"
          }
        }
      }
    },
    "从上方向下写短竖，在基线处向右轻弯收笔，不加点。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从上方向下写短竖，在基线处向右轻弯收笔，不加点。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw a short downstroke, curving right at the baseline; no dot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "短い縦線を下ろし、基線で軽く右へ曲げます。点は付けません。"
          }
        }
      }
    },
    "先写左侧短竖。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先写左侧短竖。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First draw the short left vertical."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず左の短い縦線を書きます。"
          }
        }
      }
    },
    "从右上斜向左侧中腰，再折向右下。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从右上斜向左侧中腰，再折向右下。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slant from upper right to left midpoint, then turn down-right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上から左の中ほどへ斜めに引き、右下へ折ります。"
          }
        }
      }
    },
    "从左上向右绕出顶部弧线，再沿右侧向下写长竖。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从左上向右绕出顶部弧线，再沿右侧向下写长竖。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Curve right from upper left, then draw a long downstroke on the right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左上から右へ上の弧を描き、右側を長く下ろします。"
          }
        }
      }
    },
    "从右侧中部向左绕出拱形，沿左侧下行收笔。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从右侧中部向左绕出拱形，沿左侧下行收笔。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arch left from the right midpoint and finish downward on the left."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右の中ほどから左へアーチを描き、左側を下りて終えます。"
          }
        }
      }
    },
    "从字身上沿向下写越过基线的长竖。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从字身上沿向下写越过基线的长竖。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw a long downstroke from the body top past the baseline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "字の上端から基線を越える長い縦線を書きます。"
          }
        }
      }
    },
    "回到字身上沿，下行后圆转向右上，再沿右侧下行并向右收笔。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回到字身上沿，下行后圆转向右上，再沿右侧下行并向右收笔。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return to the body top, descend and round up-right, descend again and finish right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "字の上端に戻り、下りて丸く右上へ返し、右側を下りて右で終えます。"
          }
        }
      }
    },
    "从左上向下略弯，到底部后转向右上。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从左上向下略弯，到底部后转向右上。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Curve slightly down from upper left, then turn up-right at the bottom."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左上から少し曲げて下り、下端で右上へ返します。"
          }
        }
      }
    },
    "从左向右写顶部短弧，回绕出中部弧线，再回绕出下部弧线，末端向下弯出。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从左向右写顶部短弧，回绕出中部弧线，再回绕出下部弧线，末端向下弯出。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw a short top arc rightward, loop through middle and lower arcs, then curve down."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上の短い弧を右へ書き、中央、下の弧へ回り、末尾を下へ曲げます。"
          }
        }
      }
    },
    "从右上向左绕过左侧与底部，经右侧回到起点闭合。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从右上向左绕过左侧与底部，经右侧回到起点闭合。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Curve left from upper right, around the bottom, then up the right to close."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上から左と下を回り、右側を上がって始点で閉じます。"
          }
        }
      }
    },
    "从左向右写顶横。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从左向右写顶横。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw the top bar left to right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上の横線を左から右へ書きます。"
          }
        }
      }
    },
    "从顶横左部向下写左侧笔画。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从顶横左部向下写左侧笔画。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw the left stroke down from the top bar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上の横線の左側から下へ書きます。"
          }
        }
      }
    },
    "从顶横右部下行，在底部向右轻弯。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从顶横右部下行，在底部向右轻弯。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Descend from the top bar's right side, curving gently right at the bottom."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上の横線の右側から下り、下端で軽く右へ曲げます。"
          }
        }
      }
    },
    "从字身中部向下写越过基线的长竖。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从字身中部向下写越过基线的长竖。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw a long vertical from mid-body below the baseline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "字の中ほどから基線を越えて長く下ろします。"
          }
        }
      }
    },
    "从竖画上端向上绕出完整圆腹，经右侧与底部回到起点。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从竖画上端向上绕出完整圆腹，经右侧与底部回到起点。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loop upward from the vertical's top into a full bowl, returning via right and bottom."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "縦線の上端から上へ丸みを描き、右と下を通って戻ります。"
          }
        }
      }
    },
    "从右上向左绕出圆腹，经底部与右侧回到起点，再向右写顶部短横。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从右上向左绕出圆腹，经底部与右侧回到起点，再向右写顶部短横。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loop left into a bowl, return around bottom and right, then add a short top bar rightward."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上から左へ丸みを描き、下と右を通って戻り、上に短い横線を右へ書きます。"
          }
        }
      }
    },
    "从右上向左绕过圆腹，转向右下写弯尾，末端向左收笔。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从右上向左绕过圆腹，转向右下写弯尾，末端向左收笔。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Curve left around the bowl, turn down-right for the tail, then finish left."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上から左へ丸みを回り、右下へ尾を曲げ、左で終えます。"
          }
        }
      }
    },
    "从顶横中部向下，在底部向右轻弯。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从顶横中部向下，在底部向右轻弯。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Descend from the top bar's midpoint, curving right at the bottom."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上の横線の中央から下り、下で軽く右へ曲げます。"
          }
        }
      }
    },
    "从左上向下弯到基线，再圆转向右上，形成开口向上的字形。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从左上向下弯到基线，再圆转向右上，形成开口向上的字形。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Curve down to the baseline then round up-right, leaving the top open."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左上から基線まで曲げて下り、丸く右上へ返して上を開けます。"
          }
        }
      }
    },
    "先从顶部向下写越过基线的长竖。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先从顶部向下写越过基线的长竖。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First draw a long vertical from the top past the baseline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず上から基線を越える長い縦線を書きます。"
          }
        }
      }
    },
    "从长竖与字身上沿的交点向左绕出椭圆，经底部与右侧闭合。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从长竖与字身上沿的交点向左绕出椭圆，经底部与右侧闭合。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At the body-top intersection, loop left into an oval, closing via bottom and right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長い縦線と字の上端の交点から左へ楕円を描き、下と右で閉じます。"
          }
        }
      }
    },
    "从左上斜向右下，越过基线。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从左上斜向右下，越过基线。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slant upper left to lower right, past the baseline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左上から右下へ、基線を越えて斜めに書きます。"
          }
        }
      }
    },
    "抬笔，从右上斜向左下，与第一笔相交。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抬笔，从右上斜向左下，与第一笔相交。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lift, then slant upper right to lower left across the first stroke."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペンを上げ、右上から左下へ1画目と交差させます。"
          }
        }
      }
    },
    "从左上向下绕成杯形，再沿右侧回升到字身上沿。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从左上向下绕成杯形，再沿右侧回升到字身上沿。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Curve down into a cup, rising on the right to the body top."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左上から下へカップ状に描き、右側を字の上端まで上がります。"
          }
        }
      }
    },
    "抬笔，从中间向下写越过基线的长竖。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抬笔，从中间向下写越过基线的长竖。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lift, then draw a central vertical below the baseline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペンを上げ、中央から基線を越えて長く下ろします。"
          }
        }
      }
    },
    "从左上向下绕出左侧圆腹，向上回转形成中间短竖，再绕出右侧圆腹，向右上收笔。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从左上向下绕出左侧圆腹，向上回转形成中间短竖，再绕出右侧圆腹，向右上收笔。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Curve down into the left bowl, rise for the central short stem, loop the right bowl and finish up-right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左の丸みを下へ描き、上へ返して中央の短い縦線を作り、右の丸みを描いて右上で終えます。"
          }
        }
      }
    },
    "从左下斜向顶点，再斜向右下。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从左下斜向顶点，再斜向右下。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slant from lower left to the apex, then down-right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左下から頂点へ斜めに上がり、右下へ下ろします。"
          }
        }
      }
    },
    "抬笔，从左向右补中横。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抬笔，从左向右补中横。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lift and add the middle bar left to right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペンを上げ、中央の横線を左から右へ加えます。"
          }
        }
      }
    },
    "从上到下写左侧主干。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从上到下写左侧主干。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw the left stem from top to bottom."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左の主軸を上から下へ書きます。"
          }
        }
      }
    },
    "从主干顶部向右依次绕出上、下两个圆腹。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从主干顶部向右依次绕出上、下两个圆腹。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From the stem top, loop right to form upper and lower bowls."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "主軸の上端から右へ、上と下の丸みを順に描きます。"
          }
        }
      }
    },
    "从上到下写左竖。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从上到下写左竖。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw the left vertical top to bottom."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左の縦線を上から下へ書きます。"
          }
        }
      }
    },
    "抬笔，从左上向右写顶横。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抬笔，从左上向右写顶横。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lift and draw the top bar rightward from upper left."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペンを上げ、左上から右へ上の横線を書きます。"
          }
        }
      }
    },
    "从顶点斜向左下，再向右写底边，最后斜回顶点闭合三角形。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从顶点斜向左下，再向右写底边，最后斜回顶点闭合三角形。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slant from apex down-left, draw the base rightward, then return to close the triangle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "頂点から左下へ、底辺を右へ書き、頂点へ戻って三角形を閉じます。"
          }
        }
      }
    },
    "从左向右写中横。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从左向右写中横。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw the middle bar left to right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中央の横線を左から右へ書きます。"
          }
        }
      }
    },
    "从左向右写底横。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从左向右写底横。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw the bottom bar left to right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下の横線を左から右へ書きます。"
          }
        }
      }
    },
    "从左向右写顶横，斜向左下，再向右写底横。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从左向右写顶横，斜向左下，再向右写底横。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw the top bar rightward, slant down-left, then draw the bottom bar rightward."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上の横線を右へ、左下へ斜めに引き、下の横線を右へ書きます。"
          }
        }
      }
    },
    "从上到下写右竖。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从上到下写右竖。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw the right vertical top to bottom."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右の縦線を上から下へ書きます。"
          }
        }
      }
    },
    "从左向右补中横。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从左向右补中横。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the middle bar left to right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中央の横線を左から右へ加えます。"
          }
        }
      }
    },
    "从顶部向左绕出大椭圆，经底部与右侧回到起点。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从顶部向左绕出大椭圆，经底部与右侧回到起点。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loop left from the top into a large oval, returning via bottom and right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上から左へ大きな楕円を描き、下と右を通って戻ります。"
          }
        }
      }
    },
    "从顶部向下写直竖；这里采用不加上下短横的写法。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从顶部向下写直竖；这里采用不加上下短横的写法。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw a straight downstroke; this form has no top or bottom bars."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上からまっすぐ縦線を書きます。この形では上下の短い横線は付けません。"
          }
        }
      }
    },
    "先从上到下写左竖。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先从上到下写左竖。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First draw the left vertical top to bottom."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず左の縦線を上から下へ書きます。"
          }
        }
      }
    },
    "从左下斜向顶点，再斜向右下，不加中横。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从左下斜向顶点，再斜向右下，不加中横。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slant lower left to apex and down-right, without a middle bar."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左下から頂点へ、右下へ斜めに書き、中央の横線は付けません。"
          }
        }
      }
    },
    "从左下向上写左竖，斜向中部低点，再斜向右上，最后下行写右竖。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从左下向上写左竖，斜向中部低点，再斜向右上，最后下行写右竖。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rise on the left, slant to the low midpoint, up-right, then down the right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左下から上へ、中央の低い点へ斜めに下り、右上へ上がって右の縦線を下ろします。"
          }
        }
      }
    },
    "从左下向上写左竖，斜向右下，再向上写右竖。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从左下向上写左竖，斜向右下，再向上写右竖。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rise on the left, slant down-right, then rise on the right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左の縦線を上へ、右下へ斜めに下り、右の縦線を上へ書きます。"
          }
        }
      }
    },
    "抬笔，从左向右写较短的中横。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抬笔，从左向右写较短的中横。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lift and draw a short middle bar left to right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペンを上げ、中央の短い横線を左から右へ書きます。"
          }
        }
      }
    },
    "抬笔，从左向右写底横。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抬笔，从左向右写底横。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lift and draw the bottom bar left to right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペンを上げ、下の横線を左から右へ書きます。"
          }
        }
      }
    },
    "从右上向左绕过顶部、左侧和底部，沿右侧回升，顶部保留字体中的小开口。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从右上向左绕过顶部、左侧和底部，沿右侧回升，顶部保留字体中的小开口。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loop from upper right around top, left and bottom, rising right; leave the font's small opening at the top."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上から上・左・下を回り、右側を上がります。上には字体にある小さな隙間を残します。"
          }
        }
      }
    },
    "从左上向右写顶横，再向下写右竖。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从左上向右写顶横，再向下写右竖。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw the top bar rightward, then the right vertical downward."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左上から上の横線を右へ、右の縦線を下へ書きます。"
          }
        }
      }
    },
    "从左竖顶部向右绕出圆腹，回到中腰。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从左竖顶部向右绕出圆腹，回到中腰。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loop right from the left vertical's top and return to mid-height."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左の縦線の上端から右へ丸みを描き、中ほどに戻ります。"
          }
        }
      }
    },
    "从右向左写顶横，斜向中部，再斜向左下，最后向右写底横。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从右向左写顶横，斜向中部，再斜向左下，最后向右写底横。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw the top bar right to left, slant to center then lower left, and finish the bottom bar rightward."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上の横線を右から左へ、中央、左下へ斜めに引き、下の横線を右へ書きます。"
          }
        }
      }
    },
    "从顶横中间向下写主干。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从顶横中间向下写主干。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw the stem down from the top bar's midpoint."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上の横線の中央から主軸を下へ書きます。"
          }
        }
      }
    },
    "从左上斜向中部交汇点，再斜向右上。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从左上斜向中部交汇点，再斜向右上。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slant upper left to the central junction, then up-right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左上から中央の交点へ、さらに右上へ斜めに書きます。"
          }
        }
      }
    },
    "从交汇点向下写竖画。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从交汇点向下写竖画。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw a vertical down from the junction."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "交点から縦線を下へ書きます。"
          }
        }
      }
    },
    "先从顶部向下写长竖。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先从顶部向下写长竖。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First draw a long downstroke from the top."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず上から長い縦線を書きます。"
          }
        }
      }
    },
    "从长竖上部向左绕出椭圆，经底部与右侧闭合。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从长竖上部向左绕出椭圆，经底部与右侧闭合。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loop left from the upper stem into an oval, closing through bottom and right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長い縦線の上部から左へ楕円を描き、下と右で閉じます。"
          }
        }
      }
    },
    "从左上斜向右下。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从左上斜向右下。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slant from upper left to lower right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左上から右下へ斜めに書きます。"
          }
        }
      }
    },
    "抬笔，从右上斜向左下。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抬笔，从右上斜向左下。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lift and slant from upper right to lower left."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペンを上げ、右上から左下へ斜めに書きます。"
          }
        }
      }
    },
    "从左上向下绕成杯形，再沿右侧回升到顶部。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从左上向下绕成杯形，再沿右侧回升到顶部。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Curve down into a cup and rise on the right to the top."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左上から下へカップ状に描き、右側を上端まで上がります。"
          }
        }
      }
    },
    "从中间顶部向下写长竖，穿过杯形底部。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从中间顶部向下写长竖，穿过杯形底部。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw a central vertical from the top through the cup's bottom."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中央上部からカップの底を通る長い縦線を書きます。"
          }
        }
      }
    },
    "从圆圈顶部向左绕过左侧与底部，再沿右侧回到起点，闭合圆圈。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从圆圈顶部向左绕过左侧与底部，再沿右侧回到起点，闭合圆圈。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loop left from the circle top, around bottom and right, closing at the start."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "円の上から左・下・右を回って始点で閉じます。"
          }
        }
      }
    },
    "抬笔，在圆圈下方从左向右写一横，与圆圈留出间隙。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抬笔，在圆圈下方从左向右写一横，与圆圈留出间隙。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lift and draw a bar below the circle, leaving a gap."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペンを上げ、円の下に隙間を空けて横線を左から右へ書きます。"
          }
        }
      }
    },
    "从右上向左绕出小椭圆，回到起点。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从右上向左绕出小椭圆，回到起点。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loop left from upper right into a small oval, returning to the start."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上から左へ小さな楕円を描き、始点に戻ります。"
          }
        }
      }
    },
    "沿右侧下行至基线，向右上轻挑收笔。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿右侧下行至基线，向右上轻挑收笔。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Descend on the right to the baseline, then flick up-right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右側を基線まで下り、軽く右上へ払います。"
          }
        }
      }
    },
    "从上方起笔，弯向左下形成字身。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从上方起笔，弯向左下形成字身。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start above and curve down-left to form the body."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上から書き始め、左下へ曲げて字の胴体を作ります。"
          }
        }
      }
    },
    "顺势围出下部椭圆，顶部保留向右的短钩。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "顺势围出下部椭圆，顶部保留向右的短钩。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue around the lower oval, leaving a short right hook at the top."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続けて下の楕円を囲み、上に右向きの短い鉤を残します。"
          }
        }
      }
    },
    "从基线向上绕出长环，再回到字身。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从基线向上绕出长环，再回到字身。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loop upward from the baseline and return to the body."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "基線から上へ長い輪を描き、字の胴体に戻ります。"
          }
        }
      }
    },
    "接写下方的小圆腹，向右收笔。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接写下方的小圆腹，向右收笔。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue with the small lower bowl and finish right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続けて下の小さな丸みを描き、右で終えます。"
          }
        }
      }
    },
    "从左上向右写圆弧肩部。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从左上向右写圆弧肩部。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw a rounded shoulder rightward from upper left."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左上から右へ丸い肩の部分を描きます。"
          }
        }
      }
    },
    "斜向左下回转，在基线向右弯出。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "斜向左下回转，在基线向右弯出。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn down-left and curve right at the baseline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左下へ斜めに戻り、基線で右へ曲げます。"
          }
        }
      }
    },
    "先写字身的小椭圆。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先写字身的小椭圆。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First draw the body's small oval."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず字の小さな楕円を描きます。"
          }
        }
      }
    },
    "右侧向下越过基线，绕出下伸环并向右上收笔。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右侧向下越过基线，绕出下伸环并向右上收笔。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Descend past the baseline on the right, loop below and finish up-right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右側を基線の下まで下り、下の輪を描いて右上で終えます。"
          }
        }
      }
    },
    "从中部向右上起笔，绕出小环。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从中部向右上起笔，绕出小环。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start at the middle, move up-right into a small loop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中央から右上へ書き始め、小さな輪を描きます。"
          }
        }
      }
    },
    "向左下转成圆腹，向右开口收笔。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向左下转成圆腹，向右开口收笔。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn down-left into a bowl, ending open on the right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左下へ丸みを作り、右側を開けて終えます。"
          }
        }
      }
    },
    "先按 е 的走向写好字身。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先按 е 的走向写好字身。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First write the body as for е."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず е と同じ運筆で胴体を書きます。"
          }
        }
      }
    },
    "抬笔，在上方加左点。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抬笔，在上方加左点。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lift and add the left dot above."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペンを上げ、上に左の点を加えます。"
          }
        }
      }
    },
    "抬笔，在上方加右点。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抬笔，在上方加右点。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lift and add the right dot above."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペンを上げ、上に右の点を加えます。"
          }
        }
      }
    },
    "先写左侧弯曲支臂，到中部连接。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先写左侧弯曲支臂，到中部连接。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First curve the left arm into the center."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず左の曲がった枝を中央へつなげます。"
          }
        }
      }
    },
    "抬笔，从上向下写中间主干。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抬笔，从上向下写中间主干。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lift and draw the central stem downward."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペンを上げ、中央の主軸を上から下へ書きます。"
          }
        }
      }
    },
    "抬笔，从右上弯向中部，再绕向右下。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抬笔，从右上弯向中部，再绕向右下。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lift, curve from upper right into the center, then lower right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペンを上げ、右上から中央へ曲げ、右下へ回します。"
          }
        }
      }
    },
    "由左上向右绕出上半圆。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由左上向右绕出上半圆。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Curve right from upper left into the upper semicircle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左上から右へ上の半円を描きます。"
          }
        }
      }
    },
    "回到中腰，再向右下绕出下半圆并收笔。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回到中腰，再向右下绕出下半圆并收笔。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return to mid-height and loop down-right through the lower semicircle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中ほどに戻り、右下へ下の半円を描いて終えます。"
          }
        }
      }
    },
    "从左上斜下到基线，圆转向右上。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从左上斜下到基线，圆转向右上。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slant down to the baseline and round up-right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左上から基線へ斜めに下り、丸く右上へ返します。"
          }
        }
      }
    },
    "从第二个高点下行，再向右上挑出。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从第二个高点下行，再向右上挑出。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Descend from the second peak and flick up-right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2つ目の頂点から下り、右上へ払います。"
          }
        }
      }
    },
    "先写 и 的两个下行笔和连接。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先写 и 的两个下行笔和连接。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First write и's two downstrokes and join."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず и の2本の下向きの線とつなぎを書きます。"
          }
        }
      }
    },
    "抬笔，在上方从左到右加短弧。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抬笔，在上方从左到右加短弧。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lift and add a short arc above, left to right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペンを上げ、上に短い弧を左から右へ加えます。"
          }
        }
      }
    },
    "先写左侧下行笔。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先写左侧下行笔。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First write the left downstroke."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず左の下向きの線を書きます。"
          }
        }
      }
    },
    "从右上接向中腰，再从中腰弯向右下。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从右上接向中腰，再从中腰弯向右下。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join upper right to mid-height, then curve down-right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上から中ほどへつなぎ、そこから右下へ曲げます。"
          }
        }
      }
    },
    "从基线写小入笔钩，上行至尖顶。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从基线写小入笔钩，上行至尖顶。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with a small baseline hook and rise to a peak."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "基線に小さな入りの鉤を書き、尖った頂点へ上がります。"
          }
        }
      }
    },
    "斜下到基线，向右上挑出。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "斜下到基线，向右上挑出。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slant down to the baseline and flick up-right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "基線へ斜めに下り、右上へ払います。"
          }
        }
      }
    },
    "从基线入笔，上行到第一个尖顶，再回到基线。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从基线入笔，上行到第一个尖顶，再回到基线。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start at the baseline, rise to the first peak and return down."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "基線から最初の頂点へ上がり、基線へ戻ります。"
          }
        }
      }
    },
    "接写第二个尖顶，末端向右上挑出。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接写第二个尖顶，末端向右上挑出。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue to a second peak and finish with an up-right flick."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続けて2つ目の頂点を書き、末尾を右上へ払います。"
          }
        }
      }
    },
    "写左侧下行笔。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写左侧下行笔。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write the left downstroke."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左の下向きの線を書きます。"
          }
        }
      }
    },
    "抬笔，从中部向右写连接横画。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抬笔，从中部向右写连接横画。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lift and draw a joining bar rightward from the middle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペンを上げ、中央から右へつなぎの横線を書きます。"
          }
        }
      }
    },
    "抬笔，写右侧下行笔，在基线向右挑出。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抬笔，写右侧下行笔，在基线向右挑出。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lift, write the right downstroke and flick right at the baseline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペンを上げ、右側を下り、基線で右へ払います。"
          }
        }
      }
    },
    "从右上向左逆时针绕出椭圆。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从右上向左逆时针绕出椭圆。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw a counterclockwise oval from upper right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上から左へ反時計回りに楕円を描きます。"
          }
        }
      }
    },
    "回到顶部闭合，留出向右的连接。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回到顶部闭合，留出向右的连接。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close at the top, leaving a rightward join."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上で閉じ、右へのつなぎを残します。"
          }
        }
      }
    },
    "先下行写左竖，再沿竖回到上部。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先下行写左竖，再沿竖回到上部。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw the left vertical down, then retrace upward."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左の縦線を下ろし、同じ線に沿って上へ戻ります。"
          }
        }
      }
    },
    "向右拱起，下行写右竖，基线处挑出。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向右拱起，下行写右竖，基线处挑出。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Arch right, descend on the right and flick at the baseline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右へ山を作り、右の縦線を下ろして基線で払います。"
          }
        }
      }
    },
    "从字身上沿向下，写越过基线的长竖。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从字身上沿向下，写越过基线的长竖。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From the body top, draw a long vertical below the baseline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "字の上端から基線を越えて長く縦線を書きます。"
          }
        }
      }
    },
    "回到字身上部，向右拱起，下行并收笔。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回到字身上部，向右拱起，下行并收笔。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return to the upper body, arch right, descend and finish."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "字の上部に戻り、右へ山を作って下り、終えます。"
          }
        }
      }
    },
    "从右上向左弯入。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从右上向左弯入。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Curve in leftward from upper right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上から左へ曲げて入ります。"
          }
        }
      }
    },
    "绕过左侧与底部，在右侧开口收笔。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绕过左侧与底部，在右侧开口收笔。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Curve around left and bottom, ending open on the right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左と下を回り、右側を開けて終えます。"
          }
        }
      }
    },
    "从左向右写略带倾斜的短横。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从左向右写略带倾斜的短横。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw a slightly slanted short bar left to right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少し傾いた短い横線を左から右へ書きます。"
          }
        }
      }
    },
    "从横画中部斜向下写主干，到基线轻挑收笔。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从横画中部斜向下写主干，到基线轻挑收笔。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slant the stem down from the bar's center, flicking at the baseline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "横線の中央から主軸を斜めに下ろし、基線で軽く払います。"
          }
        }
      }
    },
    "先写左侧下行弧，回升到右上。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先写左侧下行弧，回升到右上。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First curve down the left and rise to upper right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず左を弧状に下り、右上へ上がります。"
          }
        }
      }
    },
    "沿右侧向下越过基线，绕出下伸环。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沿右侧向下越过基线，绕出下伸环。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Descend on the right past the baseline and make a lower loop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右側を基線の下まで下り、下に輪を描きます。"
          }
        }
      }
    },
    "从中部先绕出左侧小椭圆。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从中部先绕出左侧小椭圆。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From the middle, first loop a small oval on the left."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中央からまず左の小さな楕円を描きます。"
