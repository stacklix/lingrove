        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中ほどから右へ下の丸みを描きます。"
          }
        }
      }
    },
    "从左上向右写半圆，回到左下。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从左上向右写半圆，回到左下。"
