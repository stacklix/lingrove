        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず и のように2本の下向きの線を書きます。"
          }
        }
      }
    },
    "末端向下越过基线，补一个短尾钩。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
