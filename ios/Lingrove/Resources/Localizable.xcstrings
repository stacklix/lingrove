            "value": "手書き機能を初期化できません。子アプリを再読み込みしてください。"
          }
        }
      }
    },
    "从五十音开始": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从五十音开始"
          }
        },
        "en": {
          "stringUnit": {
