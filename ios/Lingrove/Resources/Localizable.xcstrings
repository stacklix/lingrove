            "value": "Start with kana"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "五十音から始める"
          }
        }
      }
    },
    "认识流畅的手写体": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "认识流畅的手写体"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discover flowing handwriting"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "流れるような手書き体を学ぶ"
          }
        }
      }
    },
    "写下新的字母": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写下新的字母"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write new letters"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい文字を書く"
          }
        }
      }
    },
    "注意手写体的环形与下伸部分，不要照抄印刷体。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注意手写体的环形与下伸部分，不要照抄印刷体。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notice the loops and descender. Do not copy the printed form."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "輪と下に伸びる部分に注目し、活字体をそのまま写さないでください。"
          }
        }
      }
    },
    "当前范字采用短横加下行笔的写法；拱形连笔也是常见变体。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前范字采用短横加下行笔的写法；拱形连笔也是常见变体。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This guide uses a short horizontal and downstrokes; joined arches are another common form."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この手本は短い横線と下向きの線で書きます。アーチ状の続け字も一般的です。"
          }
        }
      }
    },
    "留意起笔与拱形，不要与 т、и 混淆。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留意起笔与拱形，不要与 т、и 混淆。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch the start and arch; distinguish it from т and и."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起筆とアーチに注意し、т や и と区別しましょう。"
          }
        }
      }
    },
    "留意两侧笔画与中间连接的走向。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留意两侧笔画与中间连接的走向。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch the sides and the direction of the connecting stroke."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両側の線と中央のつなぎ方に注意しましょう。"
          }
        }
      }
    },
    "数清连续起伏，注意与 и、щ 的区别。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数清连续起伏，注意与 и、щ 的区别。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Count the arches; distinguish it from и and щ."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "山の数を確認し、и や щ と区別しましょう。"
          }
        }
      }
    },
    "末端有下伸部分，注意与 ш 区分。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "末端有下伸部分，注意与 ш 区分。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ending descends below the line; distinguish it from ш."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "末尾は下に伸びます。ш と区別しましょう。"
          }
        }
      }
    },
    "上方短弧是字母的一部分，不要漏写。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上方短弧是字母的一部分，不要漏写。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The short arc above is part of the letter. Do not omit it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上の短い弧も文字の一部です。忘れずに書きましょう。"
          }
        }
      }
    },
    "上方两点是字母的一部分，不要漏写。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上方两点是字母的一部分，不要漏写。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The two dots above are part of the letter. Do not omit them."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上の2点も文字の一部です。忘れずに書きましょう。"
          }
        }
      }
    },
    "留意竖画与下方的环形。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留意竖画与下方的环形。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch the vertical stroke and the lower loop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "縦線と下の輪に注意しましょう。"
          }
        }
      }
    },
    "注意两部分的间距与比例。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注意两部分的间距与比例。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch the spacing and proportion of the two parts."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2つの部分の間隔と比率に注意しましょう。"
          }
        }
      }
    },
    "观察笔画的先后、方向与位置，再独立书写。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
