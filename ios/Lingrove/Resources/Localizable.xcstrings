    "Token 必须为 6 位英文字母或数字，区分大小写。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Token 必须为 6 位英文字母或数字，区分大小写。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The token must be exactly 6 letters or digits (A–Z, a–z, 0–9). It is case-sensitive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Token は半角英数字6文字で入力してください。大文字と小文字は区別されます。"
          }
        }
      }
    },
    "Token 仅保存在本机 Keychain，通过 Stack-Pass 请求头发送。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Token 仅保存在本机 Keychain，通过 Stack-Pass 请求头发送。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The token is stored only in this device’s Keychain and sent in the Stack-Pass header."
