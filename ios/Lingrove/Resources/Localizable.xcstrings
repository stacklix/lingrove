          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app installation records have an invalid format or cannot be read. The original file has been preserved. Built-in apps are being used and automatic updates are paused."
          }
        },
        "ja": {
          "stringUnit": {
