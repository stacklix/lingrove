    "无法获取或打开安装包，请稍后重试，或通过安装页面更新。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法获取或打开安装包，请稍后重试，或通过安装页面更新。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to fetch or open the installer. Try again later or use the installation page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストーラの取得または起動に失敗しました。後で再試行するか、インストールページから更新してください。"
          }
        }
      }
    },
    "更新 Lingrove 宿主 App。安装需系统确认，且设备必须已登记；安装期间请返回主屏幕等待完成。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新 Lingrove 宿主 App。安装需系统确认，且设备必须已登记；安装期间请返回主屏幕等待完成。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update the Lingrove host App. Installation requires system confirmation and a registered device. Return to the Home Screen and wait for installation to finish."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Lingrove ホスト App を更新します。インストールにはシステムの確認とデバイスの登録が必要です。ホーム画面に戻って完了をお待ちください。"
          }
        }
      }
    },
    "安装最新版": {
      "localizations": {
        "zh-Hans": {
