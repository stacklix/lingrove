          "stringUnit": {
            "state": "translated",
            "value": "Draw from upper right to the bottom for the right stem."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上から下まで書き、右の主軸を作ります。"
