    "直接用 Apple Pencil 在格内书写；可在画板外滑动页面。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接用 Apple Pencil 在格内书写；可在画板外滑动页面。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write in the grid with Apple Pencil. Scroll outside the pad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Pencil で枠内に書いてください。枠外ではページをスクロールできます。"
          }
        }
      }
    },
    "笔画较多，请清空后重新书写。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "笔画较多，请清空后重新书写。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many strokes. Clear and write again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "筆画が多すぎます。クリアして書き直してください。"
          }
        }
      }
    },
    "原生手写初始化失败，请重新加载子应用。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原生手写初始化失败，请重新加载子应用。"
          }
