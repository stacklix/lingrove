        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "肉を食べない人／昨日読んだ本"
          }
        }
      }
    },
    "这里讲动词；形容词与形容动词另见「形容词」一章，如高い山、静かな町。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里讲动词；形容词与形容动词另见「形容词」一章，如高い山、静かな町。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This chapter covers verbs. For 高い山 or 静かな町, see adjectives."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでは動詞を扱います。高い山・静かな町などは形容詞の章を参照してください。"
          }
        }
      }
    },
    "连接ば，表示某个条件成立时的结果。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接ば，表示某个条件成立时的结果。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Takes ば to express a result under a condition."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ばに接続し、ある条件が成立した場合の結果を表します。"
          }
        }
      }
    },
    "词尾う段 → え段。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "词尾う段 → え段。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Final u-row → e-row."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "語尾のウ段をエ段にします。"
          }
        }
      }
    },
    "去る＋れ。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "去る＋れ。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove る, add れ."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "るを取ってれを付けます。"
          }
        }
      }
    },
    "条件 · ば": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "条件 · ば"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conditional · ば"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "条件 · ば"
          }
        }
      }
    },
    "假定形后接ば，构成完整的条件表达。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "假定形后接ば，构成完整的条件表达。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add ば to the conditional base for the full expression."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仮定形にばを付け、条件表現を作ります。"
          }
        }
      }
    },
    "放进句子": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "放进句子"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In a sentence"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文の中で"
          }
        }
      }
    },
    "前半句给出条件，后半句说明结果。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前半句给出条件，后半句说明结果。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first clause gives the condition; the second gives the result."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前半で条件、後半で結果を述べます。"
          }
        }
      }
    },
    "毎日読めば、少しずつわかる。（每天读，就会一点点明白。）": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日読めば、少しずつわかる。（每天读，就会一点点明白。）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日読めば、少しずつわかる。— Read every day and you will gradually understand."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日読めば、少しずつわかる。"
          }
        }
      }
    },
    "与其他条件、可能表达区分": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与其他条件、可能表达区分"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other conditionals and potential"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他の条件・可能表現との区別"
          }
        }
      }
    },
    "たら、と、なら不能都归为原动词的假定形；え段＋る构成的可能动词也不是假定形。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "たら、と、なら不能都归为原动词的假定形；え段＋る构成的可能动词也不是假定形。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "たら, と, なら are not all original conditional bases; e-row + る potential verbs are not conditional bases either."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "たら、と、ならをすべて元の動詞の仮定形とは扱えません。エ段＋るの可能動詞も仮定形ではありません。"
          }
        }
      }
    },
    "読め＋ば → 読めば（如果读）／読める（能够读）": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "読め＋ば → 読めば（如果读）／読める（能够读）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "読め＋ば → 読めば (if one reads) / 読める (can read)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読め＋ば → 読めば（条件）／読める（可能）"
          }
        }
      }
    },
    "假定形是「書け」，ば形是「書けば」：后者包含接续助词ば。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "假定形是「書け」，ば形是「書けば」：后者包含接续助词ば。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "書け is the conditional base; 書けば is the ba form, including conjunction ば."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仮定形は書け、バ形は書けばです。後者には接続助詞ばが含まれます。"
