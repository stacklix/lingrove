          "stringUnit": {
            "state": "translated",
            "value": "Finish rightward at lower right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後に右下で右へ終えます。"
          }
        }
      }
    },
    "先写 Ш。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先写 Ш。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First write Ш."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず Ш を書きます。"
          }
        }
      }
    },
    "右下补越过基线的短尾。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右下补越过基线的短尾。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a short tail below the baseline at lower right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右下に基線を越える短い尾を加えます。"
          }
        }
      }
    },
    "从左向右写顶部肩部，再向下写主干。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从左向右写顶部肩部，再向下写主干。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw the top shoulder left to right, then the stem downward."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上の肩を左から右へ書き、主軸を下ろします。"
          }
        }
      }
    },
    "在下部向右绕出圆腹。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在下部向右绕出圆腹。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loop the lower bowl rightward."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下部で右へ丸みを描きます。"
          }
        }
      }
    },
    "先写左侧主干及下部圆腹。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先写左侧主干及下部圆腹。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First draw the left stem and lower bowl."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず左の主軸と下の丸みを書きます。"
          }
        }
      }
    },
    "在右侧另写下行主干。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在右侧另写下行主干。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw a separate right downstem."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右側に別の下向きの主軸を書きます。"
          }
        }
      }
    },
    "从中腰向右绕出下部圆腹。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从中腰向右绕出下部圆腹。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loop the lower bowl rightward from mid-height."
