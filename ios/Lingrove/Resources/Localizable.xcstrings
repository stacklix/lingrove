    },
    "行く的音便": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "行く的音便"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sound change of 行く"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行くの音便"
          }
        }
      }
    },
    "行く不用「行いて／行いた」，而用促音便。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "行く不用「行いて／行いた」，而用促音便。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "行く uses gemination, not 行いて／行いた."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行くは行いて／行いたではなく、促音便になります。"
          }
        }
      }
    },
    "て形、た形包含后接成分，不等于单独的连用形；た形也用于「〜たことがある」「〜たら」等表达。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "て形、た形包含后接成分，不等于单独的连用形；た形也用于「〜たことがある」「〜たら」等表达。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Te/ta forms include endings, not just the continuative base. Ta also occurs in 〜たことがある and 〜たら."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テ形・タ形は後続要素を含み、連用形単独ではありません。タ形は〜たことがある、〜たらなどにも使います。"
          }
        }
      }
    },
    "用于结束句子。现代动词的终止形与辞书形相同。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于结束句子。现代动词的终止形与辞书形相同。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ends a sentence. Modern verb terminal forms match dictionary forms."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文を終える形です。現代語の動詞では終止形と辞書形が同じです。"
          }
        }
      }
    },
    "保留辞书形。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留辞书形。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the dictionary form."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "辞書形のままです。"
          }
        }
      }
    },
    "保留する。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
