        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Context determines the time of affirmative non-past."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非過去肯定の時間的意味は文脈で決まります。"
          }
        }
      }
    },
    "毎日、本を読む。（每天看书。）／明日、京都へ行く。（明天去京都。）": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日、本を読む。（每天看书。）／明日、京都へ行く。（明天去京都。）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日、本を読む。— I read every day. / 明日、京都へ行く。— I will go to Kyoto tomorrow."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日、本を読む。／明日、京都へ行く。"
