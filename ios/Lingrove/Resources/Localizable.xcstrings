    "静かだ ↔ 静か；修饰名词用静かな": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "静かだ ↔ 静か；修饰名词用静かな"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "静かだ ↔ 静か; 静かな before a noun"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "静かだ ↔ 静か；名詞修飾は静かな"
          }
        }
      }
    },
    "六种活用形 → 教育文法表达": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "六种活用形 → 教育文法表达"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Six bases → Learner grammar expressions"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "6つの活用形 → 日本語教育文法の表現"
          }
        }
      }
    },
    "未然形 → ない形・意向形・受身形・使役形": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未然形 → ない形・意向形・受身形・使役形"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Irrealis → Negative, volitional, passive, causative"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未然形 → ナイ形・意向形・受身形・使役形"
          }
        }
      }
    },
    "未然形是接续前的部分，如読ま、読も、食べ。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未然形是接续前的部分，如読ま、読も、食べ。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The irrealis base is the part before the ending, e.g. 読ま, 読も, 食べ."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未然形は後続要素が付く前の部分です。例：読ま、読も、食べ。"
          }
        }
      }
    },
    "按否定、意愿、受身、使役等表达分别命名。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按否定、意愿、受身、使役等表达分别命名。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forms are named for negation, volition, passive, causative, and so on."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "否定、意志、受身、使役など、表現ごとに名前が付きます。"
          }
        }
      }
    },
    "未然形＋ない → ない形：読ま＋ない → 読まない。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未然形＋ない → ない形：読ま＋ない → 読まない。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Irrealis + ない → negative: 読ま＋ない → 読まない."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未然形＋ない → ナイ形：読ま＋ない → 読まない。"
          }
        }
      }
    },
    "五段未然形（お段）＋う → 意向形：読も＋う → 読もう；一段等用よう：食べ＋よう → 食べよう。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "五段未然形（お段）＋う → 意向形：読も＋う → 読もう；一段等用よう：食べ＋よう → 食べよう。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Godan o-row base + う → volitional: 読も＋う → 読もう. Ichidan uses よう: 食べ＋よう → 食べよう."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "五段のオ段未然形＋う → 意向形：読も＋う → 読もう。一段などはよう：食べ＋よう → 食べよう。"
          }
        }
      }
    },
    "未然形＋れる／られる → 受身形：読ま＋れる → 読まれる；食べ＋られる → 食べられる。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未然形＋れる／られる → 受身形：読ま＋れる → 読まれる；食べ＋られる → 食べられる。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Irrealis + れる／られる → passive: 読まれる, 食べられる."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未然形＋れる／られる → 受身形：読ま＋れる → 読まれる、食べ＋られる → 食べられる。"
          }
        }
      }
    },
    "未然形＋せる／させる → 使役形：読ま＋せる → 読ませる；食べ＋させる → 食べさせる。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未然形＋せる／させる → 使役形：読ま＋せる → 読ませる；食べ＋させる → 食べさせる。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Irrealis + せる／させる → causative: 読ませる, 食べさせる."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未然形＋せる／させる → 使役形：読ま＋せる → 読ませる、食べ＋させる → 食べさせる。"
          }
        }
      }
    },
    "未然形不等于ない形；它可以连接多种成分。する、来る的具体变化见未然形一节。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未然形不等于ない形；它可以连接多种成分。する、来る的具体变化见未然形一节。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The irrealis base is not the negative form; it takes several endings. See the irrealis chapter for する and 来る."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未然形はナイ形そのものではなく、さまざまな要素に接続します。する・来るの変化は未然形の章を参照してください。"
          }
        }
      }
    },
    "连用形 → ます形・て形・た形": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连用形 → ます形・て形・た形"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuative → masu, te, ta forms"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連用形 → マス形・テ形・タ形"
          }
        }
      }
    },
    "连用形是読み、食べ等；五段接て、た时常出现音便，如読ん。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连用形是読み、食べ等；五段接て、た时常出现音便，如読ん。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuative bases include 読み and 食べ. Godan often changes sound before て or た, e.g. 読ん."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連用形は読み、食べなどです。五段はて・たに接続するとき、読んのような音便がよく起こります。"
          }
        }
      }
    },
    "把礼貌表达、连接表达、过去表达分别作为常用形式学习。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把礼貌表达、连接表达、过去表达分别作为常用形式学习。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Polite, linking and past expressions are taught as common forms."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "丁寧表現、接続表現、過去表現をそれぞれの形として学びます。"
          }
        }
      }
    },
    "连用形＋ます → ます形：読み＋ます → 読みます。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连用形＋ます → ます形：読み＋ます → 読みます。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuative + ます → masu form: 読み＋ます → 読みます."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連用形＋ます → マス形：読み＋ます → 読みます。"
          }
        }
      }
    },
    "连用形（含音便）＋て／で → て形：食べ＋て → 食べて；読ん＋で → 読んで。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连用形（含音便）＋て／で → て形：食べ＋て → 食べて；読ん＋で → 読んで。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuative (with sound changes) + て／で → te form: 食べて, 読んで."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連用形（音便を含む）＋て／で → テ形：食べ＋て → 食べて、読ん＋で → 読んで。"
          }
        }
      }
    },
    "连用形（含音便）＋た／だ → た形：食べ＋た → 食べた；読ん＋だ → 読んだ。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连用形（含音便）＋た／だ → た形：食べ＋た → 食べた；読ん＋だ → 読んだ。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuative (with sound changes) + た／だ → ta form: 食べた, 読んだ."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連用形（音便を含む）＋た／だ → タ形：食べ＋た → 食べた、読ん＋だ → 読んだ。"
          }
        }
      }
    },
    "教材中的「ます形」有时指読みます，有时指去ます后的読み；本页用「连用形」明确表示接续前的部分。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "教材中的「ます形」有时指読みます，有时指去ます后的読み；本页用「连用形」明确表示接续前的部分。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some textbooks use “masu form” for 読みます, others for 読み. Here “continuative” specifically means the base before the ending."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "教材の「マス形」は読みますを指す場合と、ますを除いた読みを指す場合があります。本ページの「連用形」は接続前の部分です。"
          }
        }
      }
    },
    "终止形 → 动词辞书形（句末用法）": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终止形 → 动词辞书形（句末用法）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal → Dictionary form at sentence end"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終止形 → 動詞の辞書形（文末用法）"
          }
        }
      }
    },
    "现代动词的终止形用于结束句子。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现代动词的终止形用于结束句子。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The terminal form ends a sentence in modern Japanese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現代語の動詞の終止形は文を終えるときに使います。"
          }
        }
      }
    },
    "同一词形称辞书形，也是非过去肯定普通形。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一词形称辞书形，也是非过去肯定普通形。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same shape is called dictionary form: plain affirmative non-past."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ語形を辞書形と呼び、非過去肯定の普通形でもあります。"
          }
        }
      }
    },
    "読む（终止形）＝読む（辞书形）：本を読む。（看书。）": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "読む（终止形）＝読む（辞书形）：本を読む。（看书。）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "読む (terminal) = 読む (dictionary): 本を読む。— Read a book."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読む（終止形）＝読む（辞書形）：本を読む。"
          }
        }
      }
    },
    "普通形不只包含辞书形，还包括読まない、読んだ、読まなかった等。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "普通形不只包含辞书形，还包括読まない、読んだ、読まなかった等。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plain forms also include 読まない, 読んだ, 読まなかった, not just dictionary form."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "普通形には辞書形だけでなく、読まない、読んだ、読まなかったなども含まれます。"
          }
        }
      }
    },
    "连体形 → 动词辞书形＋名词": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连体形 → 动词辞书形＋名词"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attributive → Dictionary form + noun"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連体形 → 動詞の辞書形＋名詞"
          }
        }
      }
    },
    "现代动词的连体形与终止形同形，用于修饰名词。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现代动词的连体形与终止形同形，用于修饰名词。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Modern verbs have identical attributive and terminal shapes; attributive modifies nouns."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現代語の動詞の連体形は終止形と同形で、名詞を修飾します。"
          }
        }
      }
    },
    "辞书形修饰名词，是「普通形修饰名词」的一部分。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辞书形修饰名词，是「普通形修饰名词」的一部分。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictionary-form noun modification is one case of plain-form noun modification."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "辞書形による名詞修飾は「普通形による名詞修飾」の一部です。"
          }
        }
      }
    },
    "読む（连体形）＋人 → 読む人（读的人）。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "読む（连体形）＋人 → 読む人（读的人）。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "読む (attributive) + 人 → 読む人 (a person who reads)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読む（連体形）＋人 → 読む人。"
          }
        }
      }
    },
    "同一个読む：本を読む。用作终止形；読む人中用作连体形。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一个読む：本を読む。用作终止形；読む人中用作连体形。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same 読む is terminal in 本を読む and attributive in 読む人."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ読むでも、本を読む。では終止形、読む人では連体形です。"
          }
        }
      }
    },
    "読まない人、読んだ本也能修饰名词，但包含ない、た等成分，不能都当作原动词的连体形。此同形关系说的是现代动词，静かだ／静かな则不同。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "読まない人、読んだ本也能修饰名词，但包含ない、た等成分，不能都当作原动词的连体形。此同形关系说的是现代动词，静かだ／静かな则不同。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "読まない人 and 読んだ本 also modify nouns but include ない or た, not just the original verb. Identical shapes apply to modern verbs; 静かだ／静かな differ."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読まない人・読んだ本も名詞を修飾しますが、ない・たを含み、すべてを元の動詞の連体形とは扱えません。同形なのは現代語の動詞で、静かだ／静かなは異なります。"
          }
        }
      }
    },
    "假定形 → 加ば后成为ば形": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "假定形 → 加ば后成为ば形"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conditional base + ば → ba form"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仮定形＋ば → バ形"
          }
        }
      }
    },
    "假定形是書け、食べれ、すれ、くれ等接续前的部分。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "假定形是書け、食べれ、すれ、くれ等接续前的部分。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conditional bases are 書け, 食べれ, すれ, くれ, before an ending."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仮定形は書け、食べれ、すれ、くれなどの接続前の部分です。"
          }
        }
      }
    },
    "ば形是包含ば的完整条件表达。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ば形是包含ば的完整条件表达。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ba form is a complete conditional including ば."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バ形はばを含む条件表現全体です。"
          }
        }
      }
    },
    "假定形＋ば → ば形：書け＋ば → 書けば；食べれ＋ば → 食べれば。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "假定形＋ば → ば形：書け＋ば → 書けば；食べれ＋ば → 食べれば。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conditional base + ば: 書け＋ば → 書けば; 食べれ＋ば → 食べれば."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "仮定形＋ば → バ形：書け＋ば → 書けば、食べれ＋ば → 食べれば。"
          }
        }
      }
    },
    "たら、と、なら也是条件表达，但并不都由原动词的假定形构成。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "たら、と、なら也是条件表达，但并不都由原动词的假定形构成。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "たら, と and なら are also conditionals, but not all use the original verb's conditional base."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "たら、と、ならも条件表現ですが、すべてが元の動詞の仮定形から成るわけではありません。"
          }
        }
      }
    },
    "命令形 → 命令形（直接对应）": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "命令形 → 命令形（直接对应）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imperative → Imperative (direct match)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "命令形 → 命令形（直接対応）"
          }
        }
      }
    },
    "动词本身变为命令形，可以直接使用。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "动词本身变为命令形，可以直接使用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The verb itself becomes imperative and can stand alone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動詞自体が命令形となり、そのまま使えます。"
          }
        }
      }
    },
    "通常也称命令形，词形基本直接对应。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通常也称命令形，词形基本直接对应。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also called imperative; the forms generally match directly."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日本語教育文法でも通常は命令形と呼び、語形はほぼ直接対応します。"
          }
        }
      }
    },
    "てください是请求表达；辞书形＋な是禁止表达，都不等于动词本身的命令形。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "てください是请求表达；辞书形＋な是禁止表达，都不等于动词本身的命令形。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "てください is a request and dictionary + な is prohibition; neither is the verb's imperative form."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "てくださいは依頼、辞書形＋なは禁止の表現で、動詞自体の命令形ではありません。"
          }
        }
      }
    },
    "不能硬套进六种活用形的表达": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不能硬套进六种活用形的表达"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expressions outside the six-base mapping"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "6つの活用形に無理に当てはめられない表現"
          }
        }
      }
    },
    "五段的可能动词是派生词；一段等可由未然形接られる表达可能。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "五段的可能动词是派生词；一段等可由未然形接られる表达可能。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Godan potential verbs are derived words; ichidan can express potential with irrealis + られる."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "五段の可能動詞は派生語です。一段などは未然形＋られるで可能を表せます。"
          }
        }
      }
    },
    "通常统一作为「可能形」学习，表示能够做某事。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通常统一作为「可能形」学习，表示能够做某事。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usually taught together as “potential form,” expressing ability."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常は「可能形」としてまとめ、何かができることを表します。"
          }
        }
      }
    },
    "五段：読む → 読める，是派生可能动词，不是読む的假定形。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "五段：読む → 読める，是派生可能动词，不是読む的假定形。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Godan: 読む → 読める is a derived potential verb, not 読む's conditional base."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "五段：読む → 読めるは派生した可能動詞で、読むの仮定形ではありません。"
          }
        }
      }
    },
    "一段：食べ＋られる → 食べられる；する → できる；来る → 来られる（こられる）。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一段：食べ＋られる → 食べられる；する → できる；来る → 来られる（こられる）。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ichidan: 食べ＋られる → 食べられる; する → できる; 来る → 来られる（こられる）."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一段：食べ＋られる → 食べられる。する → できる、来る → 来られる（こられる）。"
          }
        }
      }
    },
    "食べられる也可表示受身，具体含义看语境。六种活用形并非教育文法全部表达的一一对应清单。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "食べられる也可表示受身，具体含义看语境。六种活用形并非教育文法全部表达的一一对应清单。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "食べられる can also be passive; context decides. The six bases do not map one-to-one to every learner expression."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "食べられるは受身にもなり、意味は文脈によります。6つの活用形は教育文法のすべての表現と一対一ではありません。"
          }
        }
      }
    },
    "不是一一对应的改名：先看“动词本身变成什么”，再看“后面接什么”，才能把两套文法对应起来。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不是一一对应的改名：先看“动词本身变成什么”，再看“后面接什么”，才能把两套文法对应起来。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are not simple renamings. First identify the changed verb base, then what follows it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単なる一対一の言い換えではありません。まず動詞自体の変化、次に後続要素を見ると、2つの体系を対応させられます。"
          }
        }
      }
    },
    "动词分类": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "动词分类"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verb classes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "動詞の分類"
          }
        }
      }
    },
    "先看辞书形和读音，再按下面四类判断。Ⅰ类是五段，Ⅱ类是一段，Ⅲ类包括サ变和カ变。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先看辞书形和读音，再按下面四类判断。Ⅰ类是五段，Ⅱ类是一段，Ⅲ类包括サ变和カ变。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check dictionary form and reading. Class I is godan, II ichidan, III suru/kuru irregular."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "辞書形と読みを確認して分類します。Ⅰ類は五段、Ⅱ類は一段、Ⅲ類はサ変とカ変です。"
          }
        }
      }
    },
    "五段动词 · Ⅰ类": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "五段动词 · Ⅰ类"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Godan · Class I"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "五段動詞 · Ⅰ類"
          }
        }
      }
    },
    "以う、く、ぐ、す、つ、ぬ、ぶ、む、る之一结尾。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以う、く、ぐ、す、つ、ぬ、ぶ、む、る之一结尾。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ends in う, く, ぐ, す, つ, ぬ, ぶ, む or る."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "う、く、ぐ、す、つ、ぬ、ぶ、む、るのいずれかで終わります。"
          }
        }
      }
    },
    "先排除する、来る等不规则词：不以る结尾的通常是五段；以る结尾且る前为あ、う、お段音的，也是五段。い段／え段＋る中另有五段词，见特殊词表。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先排除する、来る等不规则词：不以る结尾的通常是五段；以る结尾且る前为あ、う、お段音的，也是五段。い段／え段＋る中另有五段词，见特殊词表。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclude irregular する and 来る first. Non-る verbs are usually godan; a/u/o + る are godan too. Some i/e + る verbs are also godan; see the special list."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "する・来るなどを除き、る以外で終わる動詞は通常五段です。ア・ウ・オ段＋るも五段です。イ・エ段＋るにも五段があるので特殊語一覧を参照してください。"
          }
        }
      }
    },
    "一段动词 · Ⅱ类": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一段动词 · Ⅱ类"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ichidan · Class II"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一段動詞 · Ⅱ類"
          }
        }
      }
    },
    "以る结尾，る前的假名是い段或え段音。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以る结尾，る前的假名是い段或え段音。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ends in る preceded by an i- or e-row sound."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "るで終わり、その前はイ段またはエ段の音です。"
          }
        }
      }
    },
    "符合「い段／え段＋る」后，还要排除五段词。見る、寝る、着る、居る等短词也属于一段，不能按汉字数量判断。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "符合「い段／え段＋る」后，还要排除五段词。見る、寝る、着る、居る等短词也属于一段，不能按汉字数量判断。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After checking i/e + る, exclude godan exceptions. Short words like 見る, 寝る, 着る, 居る are ichidan; kanji count is not a guide."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イ・エ段＋るでも五段を除く必要があります。見る、寝る、着る、居るなどの短い語も一段で、漢字数では判断できません。"
          }
        }
      }
    },
    "起きる（き＝い段）／食べる（べ＝え段）／見る（みる）／寝る（ねる）": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "起きる（き＝い段）／食べる（べ＝え段）／見る（みる）／寝る（ねる）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "起きる (き = i-row) / 食べる (べ = e-row) / 見る / 寝る"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起きる（き＝イ段）／食べる（べ＝エ段）／見る（みる）／寝る（ねる）"
          }
        }
      }
    },
    "サ变动词 · Ⅲ类": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "サ变动词 · Ⅲ类"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suru irregular · Class III"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サ変動詞 · Ⅲ類"
          }
        }
      }
    },
    "サ变动词": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "サ变动词"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suru irregular verbs"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サ変動詞"
          }
        }
      }
    },
    "する，或能与する结合的动作性词语＋する。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "する，或能与する结合的动作性词语＋する。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "する, or an action word that combines with する."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "する、またはするに結び付く動作性の語＋するです。"
          }
        }
      }
    },
    "确认词义和构成中包含表示“做”的する。不是所有名词都能加する；擦る（する，摩擦）是五段，不能只看读音。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认词义和构成中包含表示“做”的する。不是所有名词都能加する；擦る（する，摩擦）是五段，不能只看读音。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm it contains する meaning “do.” Not all nouns take する. 擦る (する, rub) is godan despite the same reading."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「する」の意味と構成を確認します。すべての名詞にするが付くわけではありません。擦る（する）は五段なので、読みだけでは判断できません。"
          }
        }
      }
    },
    "カ变动词 · Ⅲ类": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "カ变动词 · Ⅲ类"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuru irregular · Class III"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カ変動詞 · Ⅲ類"
          }
        }
      }
    },
    "カ变动词": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "カ变动词"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuru irregular verbs"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カ変動詞"
          }
        }
      }
    },
    "来る（くる），以及包含这个来る的表达。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来る（くる），以及包含这个来る的表达。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "来る (くる) and expressions containing this “come.”"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "来る（くる）およびこの来るを含む表現です。"
          }
        }
      }
    },
    "确认其中的来る表示“来”。仅以くる结尾不算カ变，如作る（つくる）是五段。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认其中的来る表示“来”。仅以くる结尾不算カ变，如作る（つくる）是五段。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm 来る means “come.” Merely ending in くる is not enough: 作る is godan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「来る」の意味を確認します。くるで終わるだけではカ変ではありません。作る（つくる）は五段です。"
          }
        }
      }
    },
    "无法确定时查词典的活用标记。同音词也可能不同类：着る／切る、居る／要る、変える／帰る，前者是一段，后者是五段。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确定时查词典的活用标记。同音词也可能不同类：着る／切る、居る／要る、変える／帰る，前者是一段，后者是五段。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check dictionary conjugation labels when unsure. Homophones may differ: 着る/切る, 居る/要る, 変える/帰る are ichidan/godan pairs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不明な場合は辞書の活用表示を確認します。同音語でも着る／切る、居る／要る、変える／帰るは、前者が一段、後者が五段です。"
          }
        }
      }
    },
    "连接否定、意向、受身、使役等成分，通常不单独使用。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接否定、意向、受身、使役等成分，通常不单独使用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Takes negative, volitional, passive or causative endings; usually not used alone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "否定、意向、受身、使役などに接続し、通常は単独で使いません。"
          }
        }
      }
    },
    "词尾う段 → あ段／お段；う结尾的あ段形式用わ。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "词尾う段 → あ段／お段；う结尾的あ段形式用わ。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Final u-row → a/o-row; final う uses わ for the a-row."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "語尾のウ段をア段／オ段へ。うのア段形はわになります。"
          }
        }
      }
    },
    "去掉末尾る。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "去掉末尾る。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove final る."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "末尾のるを取ります。"
          }
        }
      }
    },
    "サ变 · する": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "サ变 · する"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suru irregular · する"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サ変 · する"
          }
        }
      }
    },
    "按接续变为し、さ、せ。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按接续变为し、さ、せ。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Becomes し, さ or せ depending on the ending."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続に応じてし、さ、せになります。"
          }
        }
      }
    },
    "カ变 · 来る": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "カ变 · 来る"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuru irregular · 来る"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カ変 · 来る"
          }
        }
