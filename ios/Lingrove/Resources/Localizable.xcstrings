    "サ变包括「する」及与它结合的动词。下面列出常见例子，并非完整词表；不是所有名词都能直接加する。" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suru verbs include する and its compounds. These are common examples, not an exhaustive list. Not every noun takes する."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サ変にはするおよびそれと結び付く動詞があります。以下は代表例で、完全な一覧ではありません。すべての名詞にするが付くわけではありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サ变包括「する」及与它结合的动词。下面列出常见例子，并非完整词表；不是所有名词都能直接加する。"
          }
        }
      }
    },
    "する，或能与する结合的动作性词语＋する。" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "する, or an action word that combines with する."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "する、またはするに結び付く動作性の語＋するです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "する，或能与する结合的动作性词语＋する。"
          }
        }
      }
    },
    "する可以表示做、进行等，具体含义取决于搭配。" : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "する can mean do or perform; meaning depends on the combination."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "するは行うことなどを表し、意味は組み合わせによります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "する可以表示做、进行等，具体含义取决于搭配。"
          }
        }
      }
    },
