            "value": "可能表現の扱い"
          }
        }
      }
    },
    "一段未然形可接られる表示可能；五段的可能动词另由え段＋る构成，不是原词的未然形。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一段未然形可接られる表示可能；五段的可能动词另由え段＋る构成，不是原词的未然形。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ichidan irrealis + られる can express ability; godan potential verbs use e-row + る, not the original irrealis base."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一段は未然形＋られるで可能を表せます。五段の可能動詞はエ段＋るで作り、元の語の未然形ではありません。"
          }
        }
      }
    },
    "表中先列动词本身的活用形，再列接续后的完整表达。「未然」不等于将来时。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "表中先列动词本身的活用形，再列接续后的完整表达。「未然」不等于将来时。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tables show the verb base first, then the complete expression. “Irrealis” does not mean future tense."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表では動詞自体の活用形、次に接続後の表現を示します。「未然」は未来時制ではありません。"
          }
        }
      }
    },
    "连接ます、て、た等成分，用于礼貌表达、动作连接和过去表达等。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接ます、て、た等成分，用于礼貌表达、动作连接和过去表达等。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Takes ます, て, た for polite speech, action linking and past expressions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ます、て、たなどに接続し、丁寧表現、動作の接続、過去表現などに使います。"
          }
        }
      }
    },
    "词尾う段 → い段；接て、た时按下表变化。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "词尾う段 → い段；接て、た时按下表变化。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Final u-row → i-row; before て/た follow the table below."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "語尾のウ段をイ段へ。て・たへの接続は下表に従います。"
          }
        }
      }
    },
