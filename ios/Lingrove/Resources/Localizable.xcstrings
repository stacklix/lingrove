        }
      }
    },
    "从左上写到右下。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从左上写到右下。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write from upper left to lower right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左上から右下へ書きます。"
          }
        }
      }
    },
    "抬笔，从右上写到左下。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抬笔，从右上写到左下。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lift and write from upper right to lower left."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペンを上げ、右上から左下へ書きます。"
          }
        }
      }
    },
    "先写左侧下行笔，沿基线连向右侧。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先写左侧下行笔，沿基线连向右侧。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First draw the left downstroke, joining right along the baseline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず左を下り、基線に沿って右へつなぎます。"
          }
        }
      }
    },
    "写右侧下行笔，末端补短尾。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写右侧下行笔，末端补短尾。"
